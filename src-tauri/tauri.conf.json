{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basalt",
  "version": "0.5.1",
  "identifier": "io.github.nino4you.basalt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Basalt",
        "width": 1280,
        "height": 840,
        "minWidth": 320,
        "minHeight": 480,
        "dragDropEnabled": false,
        "backgroundColor": "#161b1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' data: ipc: http://ipc.localhost https: wss: basalt-resource: http://basalt-resource.localhost; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src blob:; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "A local-first Markdown workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 26 }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMzA1RUE5QzM3MzdERjAKUldUd2ZYUERxVjR3TVYvVnJqQkcxZGwyN3FVVTZtQjArZkl5Y29VemU0OC80cVBUZDFLdDlMQ2cK",
      "endpoints": [
        "https://github.com/Nino4you/basalt/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
